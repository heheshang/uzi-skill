# UZI-Skill · 本地环境变量（全部可选）
# 把本文件复制为 .env 并填入你自己的值：
#   cp .env.example .env
#   # 然后编辑 .env 填 key
#
# 说明：所有变量都可在命令行临时覆盖，例如
#   UZI_DEPTH=lite uzi 600519
# 也可以用等价的 CLI 参数，例如 `uzi 600519 --depth lite --school E`。

# ─── 东财妙想 Skills Hub API（推荐配置）──────────────────────
# 设置后 UZI-Skill 会优先使用官方 NLP API 做：
#   1. 中文名纠错（"北部港湾" 自动识别为 "北部湾港"）
#   2. 股票行情快照（稳定性远高于爬 push2.eastmoney.com）
# 获取 key（免费）: https://dl.dfcfs.com/m/itc4
MX_APIKEY=

# ─── 分析范围与产物路径 ────────────────────────────────────
# UZI_DEPTH=medium              # 分析深度 lite|medium|deep（等价 --depth）
# UZI_SCHOOL=E                  # 锁定单一流派 A..I（等价 --school）
# UZI_PERSONAS_DIR=skills/deep-analysis/personas   # 66 位评委 persona YAML 目录
# UZI_CACHE_ROOT=.cache         # 缓存根：raw_data.json / dimensions / panel / synthesis
# UZI_REPORTS_DIR=reports       # 报告输出根（full-report.html 等）
# UZI_REPORTS_ROOT=reports      # 每日筛选报告根（--screen daily）
# UZI_ASSETS_DIR=assets         # 报告模板 / 头像 / audience 清单目录

# ─── 抓取与网络 ───────────────────────────────────────────
# STOCK_NO_CACHE=1              # 禁用所有 API 缓存，强制重新拉取
# UZI_SKIP_PREFLIGHT=1          # 跳过网络预检（预检失败会自动切 lite）
# UZI_LITE=1                    # 精简模式；设 0 可禁止网络不佳时自动降级
# UZI_HTTP_TIMEOUT=20           # 单次 HTTP 超时秒数，默认 20
# UZI_PLAYWRIGHT_ENABLE=1       # opt-in 浏览器抓取；medium 需显式开启，deep 默认开启
# UZI_PLAYWRIGHT_FORCE=1        # 重试全部白名单维度，而非只补失败维度
# UZI_XQ_LOGIN=1                # 启用雪球登录态抓取（首次需先跑 `uzi --xueqiu-login`）
# UZI_DDG_BUDGET=15             # DuckDuckGo 搜索全局预算（次数）
# UZI_DDG_TIMEOUT=10            # 单次 DuckDuckGo 搜索超时秒数，默认 10
# UZI_DISABLE_GLOBAL_PEERS=1    # 关闭全球同行，只保留本地市场同行
# UZI_GLOBAL_PEER_LIMIT=8       # 全球同行补全数量，支持 3-12

# ─── 流程控制与输出 ───────────────────────────────────────
# UZI_SKIP_REVIEW=1             # 跳过出报告前的自检门禁（等价 --stage-review 之外的自检）
# UZI_NO_RESUME=1               # 不读取上次记录的 depth（等价 --no-resume）
# UZI_NO_UPDATE_CHECK=1         # 跳过启动时的版本检查
# UZI_LANG=zh                   # persona 标题语言，默认 zh
# UZI_LIVE_TEST=1               # 仅测试用：允许联网的 live 测试
